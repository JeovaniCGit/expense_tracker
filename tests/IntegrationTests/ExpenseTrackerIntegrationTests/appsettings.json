{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Hangfire": {
    "SchedulePollingIntervalInSeconds": 15,
    "ServerName": "ExpenseTrackerHangfireServer"
  },
  "Postgres": {
    "Port": 5432
  },
  "Jwt": {
    "Issuer": "http://localhost:5037",
    "Audience": "http://localhost:5037",
    "AccessTokenExpiryMinutes": 5,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "FromEmail": "test@outlook.com",
    "FromName": "ExpenseTrackerTeam"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5037"
    ]
  }
}